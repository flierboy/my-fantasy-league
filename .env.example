# =============================================================================
# Environment variables for Yahoo Keepers League
# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables (Production + Preview).
# =============================================================================

# Required — from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional — service role for one-time CLI seed only (npm run seed:upper-deckers).
# NEVER expose to the browser or prefix with NEXT_PUBLIC_.
# Not required for normal app operation — prefer SQL Editor for seeding.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
