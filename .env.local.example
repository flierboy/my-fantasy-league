# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional — only for one-time CLI seed (npm run seed:upper-deckers)
# From Supabase → Project Settings → API → service_role (secret)
# NEVER prefix with NEXT_PUBLIC_ and never commit this value.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email via Resend (polls, announcements, weekly results)
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Upper Deckcers <onboarding@resend.dev>
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
